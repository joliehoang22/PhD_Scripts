### START HERE: add 1 SV at a time for BP MSSM and HBCC and test their correlation 
# Step 1: Estimate the number of SVs
n.sv = num.sv(v.MSSM$E, design.MSSM, method = "be") 

# Initialize a list to store results for each DEA
all_results_sv <- list()

# Loop through the number of SVs from 1 to the estimated n.sv
for (i in 1:n.sv) {
  cat("Running DEA with", i, "SV(s)\n")
  
  # Step 2: Generate SVs with the current number `i`
  svobj <- sva(v.MSSM$E, design.MSSM, design0.MSSM, n.sv = i)
  temp <- svobj$sv
  colnames(temp) <- paste0('sv', 1:ncol(temp))
  
  # Step 3: Create the design matrix with `i` SVs
  design_sv <- cbind(design.MSSM, temp)

  # Step 4: Perform DEA using limma
  fit_sv <- lmFit(v.MSSM$E, design_sv)  # Ensure correct input matrix
  fit2 <- eBayes(fit_sv)  
  results_sv <- topTable(fit2, coef = "DxBP", number = Inf) 

  # Add gene names to the results and reformat
  results_sv$X <- rownames(results_sv)
  results_sv_formatted <- results_sv[, c("X", "logFC", "AveExpr", "t", "P.Value", "adj.P.Val", "B")]
  row.names(results_sv_formatted) <- 1:nrow(results_sv_formatted)
  
  # Store the results in the list
  all_results_sv[[i]] <- results_sv_formatted
}

# Directory where results will be stored
output_dir <- "/sc/arion/projects/mscic1/results/jolie/CMC/BP/"

# Save results to CSV files
for (i in 1:n.sv) {
  file_path <- file.path(output_dir, paste0("bp_mssm_sva_be_", i, "_SVs.csv"))
  write.csv(all_results_sv[[i]], file = file_path, row.names = FALSE)
}

