#################################
### VCF (Variant Call Format) ###
#################################
#Purpose: Contains genotype data — which alleles each sample carries at each genetic variant (e.g., SNP).
##fileformat=VCFv4.2
##source=PLINK
#CHROM  POS       ID          REF  ALT  QUAL  FILTER  INFO  FORMAT   Sample1   Sample2   Sample3
1       752566    rs3094315   G    A    .     PASS    .     GT       0|0       0|1       1|1
1       752721    rs3131972   A    G    .     PASS    .     GT       0|1       0|0       0|1
1       762320    rs11240777  C    T    .     PASS    .     GT       0|0       0|0       0|1

#Header lines (##) describe metadata.
#CHROM: Chromosome number.
# POS: Genomic position (1-based).
# ID: SNP rsID or unique name.
# REF / ALT: Reference and alternate alleles.
# FORMAT: Describes how genotype data are stored (here GT = genotype).
# Sample columns: Each shows the genotype per individual:
# 0|0 = homozygous reference
# 0|1 = heterozygous
# 1|1 = homozygous alternate
# These genotypes are what QTLtools uses to test for associations with gene expression.

#########################################################
###  BED (Browser Extensible Data) in QTLtools format ###
#########################################################
#In QTLtools, the first 4 columns define the feature (gene/exon), and subsequent columns hold sample-level values.
#Purpose: Contains phenotype data (e.g., normalized gene expression) in a tab-delimited matrix.
#chr   start     end       gene_id        Sample1    Sample2   Sample3
1      11868     14412     ENSG00000223972  5.23       4.87      5.01
1      14361     29370     ENSG00000227232  7.11       7.35      7.09
1      29554     31109     ENSG00000243485  3.02       3.19      3.08

#chr / start / end: Genomic location of the feature (gene, exon, or transcript).
# gene_id: Unique feature ID (e.g., Ensembl gene).
# Sample columns: Quantitative expression values per sample (log₂(TPM+1), residuals, etc.).
# These must correspond in order to the samples in the VCF file.

#########################################################
############### How QTLtools uses them ###############
#########################################################
# For each gene:
# It looks at variants in the VCF within ±1 Mb (cis-window).
# Reads expression from the BED file for that gene across samples.
# Tests if genotype dosage (0, 1, 2) correlates with expression values (expression ~ genotype + covariates)
# Writes results in output tables like:
#chr   start    end    phenotype_id      variant_id        distance  p_nominal
1      11868    14412  ENSG00000223972  1_752566_G_A       250000     0.01234
1      14361    29370  ENSG00000227232  1_762320_C_T       10000      3.5e-06

##results might look different with empirical testing aka there will be info about empirical p-value per gene (corrected for testing many SNPs per gene)
#chr  start    end      phenotype_id      nsnps   beta   slope   slope_se   pval_nominal_best   pval_perm   pval_beta
1     11868    14412    ENSG00000223972  183     0.22   0.135   0.023       1.2e-06             0.017        0.019
1     14361    29370    ENSG00000227232  160     0.44   0.202   0.028       2.6e-09             2.0e-05      2.3e-05
# chr / start / end	Gene coordinates (from BED).
# phenotype_id	Gene or transcript ID.
# nsnps	Number of SNPs tested for that gene.
# beta	Shape parameter for beta distribution (used to extrapolate p-values).
# slope	Effect size (β) of the most significant SNP for that gene.
# slope_se	Standard error of that effect size.
# pval_nominal_best	Nominal p-value of the top SNP.
# pval_perm	Empirical p-value after 10,000 permutations (gene-level significance).
# pval_beta	Beta-approximated permutation p-value (usually used for FDR).

