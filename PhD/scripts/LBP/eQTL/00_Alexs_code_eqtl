tr -d '\r' < "$PM"  | awk 'NF' | sort -u > "$OUTDIR/tmp/pm.clean"

# 1) header → name→column map (columns are 1-based; samples start at col 7)
zcat "$SRC" | head -n1 | tr '\t' '\n' | nl -ba > "$OUTDIR/tmp/header.nl"
# Validate first 6 fields are the fixed BED columns
awk 'NR==1{if($2!="#Chr"){print "BAD header col1"; exit 1}} 
     NR==2{if($2!="start"){print "BAD header col2"; exit 1}}
     NR==3{if($2!="end"){print "BAD header col3"; exit 1}}
     NR==4{if($2!="pid"){print "BAD header col4"; exit 1}}
     NR==5{if($2!="gid"){print "BAD header col5"; exit 1}}
     NR==6{if($2!="strand"){print "BAD header col6"; exit 1}}' "$OUTDIR/tmp/header.nl" || exit 1

# 2) Build exact index lists for LIV and PM in SOURCE ORDER
# name2col.tsv: <sample>\t<col_index>
awk 'NR>6{print $2"\t"$1}' "$OUTDIR/tmp/header.nl" > "$OUTDIR/tmp/name2col.tsv"

# collect indices present in header for your clean lists
awk 'FNR==NR{h[$1]=1; next} ($1 in h){print $2}' "$OUTDIR/tmp/liv.clean" "$OUTDIR/tmp/name2col.tsv" | sort -n > "$OUTDIR/tmp/liv.idx"
awk 'FNR==NR{h[$1]=1; next} ($1 in h){print $2}' "$OUTDIR/tmp/pm.clean"  "$OUTDIR/tmp/name2col.tsv" | sort -n > "$OUTDIR/tmp/pm.idx"

# diagnostics: which requested names are missing from the header?
echo "LIV names missing from header:"
comm -23 <(sort "$OUTDIR/tmp/liv.clean") <(cut -f1 "$OUTDIR/tmp/name2col.tsv" | sort) | head
echo "PM names missing from header:"
comm -23 <(sort "$OUTDIR/tmp/pm.clean")  <(cut -f1 "$OUTDIR/tmp/name2col.tsv" | sort) | head

# 3) Emit split files with correct header + rows using awk (keeps tabs intact)
awk -v OFS='\t' -v LIVIDX="$OUTDIR/tmp/liv.idx" -v PMIDX="$OUTDIR/tmp/pm.idx" '
  BEGIN{
    while((getline < LIVIDX)>0){liv[$1]=1; liv_n++; liv_ord[++li]=$1}
    close(LIVIDX)
    while((getline < PMIDX)>0){pm[$1]=1; pm_n++; pm_ord[++pi]=$1}
    close(PMIDX)
  }
  NR==1{
    # print headers
    printf("#Chr\tstart\tend\tpid\tgid\tstrand") > "'"$OUTDIR"'/QC2CALLSET_nsv10.LIV.bed"
    for(i=1;i<=li;i++) printf("\t%s", $liv_ord[i]) > "'"$OUTDIR"'/QC2CALLSET_nsv10.LIV.bed"
    printf("\n") > "'"$OUTDIR"'/QC2CALLSET_nsv10.LIV.bed"

    printf("#Chr\tstart\tend\tpid\tgid\tstrand") > "'"$OUTDIR"'/QC2CALLSET_nsv10.PM.bed"
    for(i=1;i<=pi;i++) printf("\t%s", $pm_ord[i]) > "'"$OUTDIR"'/QC2CALLSET_nsv10.PM.bed"
    printf("\n") > "'"$OUTDIR"'/QC2CALLSET_nsv10.PM.bed"
    next
  }
  {
    # write rows
    # core 6 columns
    core=$1 OFS $2 OFS $3 OFS $4 OFS $5 OFS $6

    # LIV row
    line=core
    for(i=1;i<=li;i++){ c=liv_ord[i]; line=line OFS $c }
    print line >> "'"$OUTDIR"'/QC2CALLSET_nsv10.LIV.bed"

    # PM row
    line=core
    for(i=1;i<=pi;i++){ c=pm_ord[i]; line=line OFS $c }
    print line >> "'"$OUTDIR"'/QC2CALLSET_nsv10.PM.bed"
  }
' <(zcat "$SRC")

