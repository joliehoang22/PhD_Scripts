#### rb calculations 
#' Calculate rb correlation between tissue eQTL effects:
#' @param dat_top Data frame with one row per gene (top eQTL only)
#'   Required columns: gene, beta_ref, se_ref, beta_test, se_test
#' @param dat_cis Optional: All cis-SNPs per gene for r_e estimation
#'   Required if assume_overlap=TRUE: gene, beta_ref, beta_test, p_ref, p_test
#' @param assume_overlap Logical: assume potential sample overlap?
#' 
#' @return List with r_b estimate and jackknife SE
compute_rb <- function(dat_top, 
                       dat_cis = NULL, 
                       assume_overlap = FALSE,
                       p_null_threshold = 0.01) {
  
  # Step 1: Estimate variance of errors (average SE^2)
  var_e_ref  <- mean(dat_top$se_ref^2, na.rm = TRUE)
  var_e_test <- mean(dat_top$se_test^2, na.rm = TRUE)
  
  cat(sprintf("var(e_ref) = %.6f\n", var_e_ref))
  cat(sprintf("var(e_test) = %.6f\n", var_e_test))
  
  # Step 2: Estimate r_e (correlation of errors)
  if (assume_overlap && !is.null(dat_cis)) {
    cat("Estimating r_e from null SNPs (P > ", p_null_threshold, ") per gene...\n")
    
    # Compute r_e for each gene using null SNPs in cis-region
    r_e_per_gene <- sapply(unique(dat_top$gene), function(g) {
      null_snps <- dat_cis %>%
        filter(gene == g, 
               p_ref > p_null_threshold, 
               p_test > p_null_threshold)
      
      if (nrow(null_snps) < 10) return(NA)  # Need sufficient null SNPs
      
      cor(null_snps$beta_ref, null_snps$beta_test, use = "complete.obs")
    })
    
    r_e_hat <- mean(r_e_per_gene, na.rm = TRUE)
    cat(sprintf("Mean r_e across genes = %.6f (estimated from %d genes)\n", 
                r_e_hat, sum(!is.na(r_e_per_gene))))
    
  } else {
    r_e_hat <- 0  # No overlap or no cis data provided
    cat("Assuming r_e = 0 (no sample overlap)\n")
  }
  
  # Step 3: Compute observed statistics across genes
  var_bhat_ref  <- var(dat_top$beta_ref, na.rm = TRUE)
  var_bhat_test <- var(dat_top$beta_test, na.rm = TRUE)
  cov_bhat      <- cov(dat_top$beta_ref, dat_top$beta_test, use = "complete.obs")
  
  cat(sprintf("var(beta_ref) = %.6f\n", var_bhat_ref))
  cat(sprintf("var(beta_test) = %.6f\n", var_bhat_test))
  cat(sprintf("cov(beta_ref, beta_test) = %.6f\n", cov_bhat))
  
  # Step 4: Calculate r_b (Equation 3 from paper)
  numerator <- cov_bhat - r_e_hat * sqrt(var_e_ref * var_e_test)
  denominator <- sqrt((var_bhat_ref - var_e_ref) * (var_bhat_test - var_e_test))
  
  r_b_hat <- numerator / denominator
  
  cat(sprintf("\nPoint estimate: r_b = %.4f\n", r_b_hat))
  
  # Step 5: Jackknife standard error (leave-one-gene-out)
  n_genes <- nrow(dat_top)
  cat(sprintf("Computing jackknife SE (n = %d genes)...\n", n_genes))
  
  r_b_jackknife <- numeric(n_genes)
  
  for (i in 1:n_genes) {
    dat_i <- dat_top[-i, ]
    
    # Recalculate for jackknife sample
    var_bhat_ref_i  <- var(dat_i$beta_ref, na.rm = TRUE)
    var_bhat_test_i <- var(dat_i$beta_test, na.rm = TRUE)
    cov_bhat_i      <- cov(dat_i$beta_ref, dat_i$beta_test, use = "complete.obs")
    
    # Note: var_e and r_e stay constant (estimated from full sample)
    num_i <- cov_bhat_i - r_e_hat * sqrt(var_e_ref * var_e_test)
    den_i <- sqrt((var_bhat_ref_i - var_e_ref) * (var_bhat_test_i - var_e_test))
    
    r_b_jackknife[i] <- num_i / den_i
  }
  
  # Jackknife variance (Equation 4 from paper)
  r_b_mean_jack <- mean(r_b_jackknife)
  se_jackknife <- sqrt(((n_genes - 1) / n_genes) * sum((r_b_jackknife - r_b_mean_jack)^2))
  
  cat(sprintf("Jackknife SE = %.4f\n", se_jackknife))
  cat(sprintf("95%% CI: [%.4f, %.4f]\n", 
              r_b_hat - 1.96*se_jackknife, 
              r_b_hat + 1.96*se_jackknife))
  
  # Return results
  list(
    r_b = r_b_hat,
    se = se_jackknife,
    ci_lower = r_b_hat - 1.96*se_jackknife,
    ci_upper = r_b_hat + 1.96*se_jackknife,
    n_genes = n_genes,
    r_e = r_e_hat,
    var_e_ref = var_e_ref,
    var_e_test = var_e_test,
    jackknife_estimates = r_b_jackknife
  )
}

#' Test if two r_b estimates are significantly different
#' 
test_rb_difference <- function(rb1, rb2) {
  # Z-test for difference
  diff <- rb1$r_b - rb2$r_b
  se_diff <- sqrt(rb1$se^2 + rb2$se^2)  # Assuming independence
  z <- diff / se_diff
  p <- 2 * pnorm(-abs(z))
  
  cat(sprintf("\nTest of difference:\n"))
  cat(sprintf("r_b1 = %.4f (SE = %.4f)\n", rb1$r_b, rb1$se))
  cat(sprintf("r_b2 = %.4f (SE = %.4f)\n", rb2$r_b, rb2$se))
  cat(sprintf("Difference = %.4f (SE = %.4f)\n", diff, se_diff))
  cat(sprintf("Z = %.4f, P = %.4e\n", z, p))
  
  list(
    difference = diff,
    se = se_diff,
    z = z,
    p_value = p
  )
}


