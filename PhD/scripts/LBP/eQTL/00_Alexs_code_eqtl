##check all files at once:
check_all_files <- function(output_dir) {
  results <- list()
  
  for(nsv in 1:30) {
    for(dataset in c("LIV", "PM")) {
      file_path <- paste0(output_dir, dataset, "_nsv", nsv, "_osca.txt")
      
      if(file.exists(file_path)) {
        dt <- fread(file_path)
        
        results[[paste0(dataset, "_nsv", nsv)]] <- list(
          n_rows = nrow(dt),
          n_genes = uniqueN(dt$Gene),
          n_snps = uniqueN(dt$SNP),
          has_na = any(is.na(dt)),
          has_inf = any(is.infinite(as.matrix(dt[, .(b, se, p)]))),
          mean_se = mean(dt$se),
          median_p = median(dt$p),
          n_extreme_p = sum(dt$p == 0)
        )
      } else {
        results[[paste0(dataset, "_nsv", nsv)]] <- "File not found"
      }
    }
  }
  
  return(results)
}

