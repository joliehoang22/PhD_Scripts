#+NAME: DONE|PRIMARY_QTL_STUFF|run_qtltools
#+BEGIN_SRC shell

# setup
  module load qtltools/1.1 tabix
  IDR=/sc/arion/projects/psychgen/lbp/data/runEQTL/20OCT2022 # input data
  SCR=/sc/arion/projects/psychgen/lbp/scratch/runEQTL/20OCT2022 # scratch (unused below)
  SDR=/sc/arion/projects/psychgen/lbp/scripts/runEQTL/20OCT2022 # scripts + job files + logs live here
  RDR=/sc/arion/projects/psychgen/lbp/results/runEQTL/20OCT2022 # results go here

# create directory structure for organizing/tracking selfsched
  cd ${SDR}
  mkdir sch run log

# make scripts for selfsched
  cd ${SDR} 
  echo "" | tail -n+2 > ${SDR}/selfsched # create/empty the task file
  rm ${SDR}/sch/* # clear old splits if any

  #Loops that enumerate parameter combinations
  #For each callset (QC2CALLSET), each nsv (1–30), each data type (MATURERNA, PRERNA), and each chunk (1–300), 
  #it writes one QTLtools command to the master list.

  for i in QC2CALLSET ##QC2STRICTCALLSET 

  ##what is the difference btw QC2CALLSET and QC2STRICTCALLSET ? seems like there's a matching LIVPM_dna.vcf.gz and LIVPM_dna_strict.vcf.gz 
  do
    if [[ ${i} == "QC2CALLSET" ]]
    then
      VCF=${IDR}/DNA/LIVPM_dna.vcf.gz #--vcf: genotypes
      COV=${IDR}/DNA/LIVPM_mds.txt
    else
      VCF=${IDR}/DNA/LIVPM_dna_strict.vcf.gz  #--vcf: genotypes
      COV=${IDR}/DNA/LIVPM_mds_strict.txt
    fi
    for j in {1..30} ## nsv = 1..30 (number of surrogate vars / covariate sets)
    do 
      for k in MATURERNA PRERNA ##RNA PROTEIN RNAEDITING 
      do
        echo ${i} ${j} ${k}
        BED=${IDR}/${k}/${i}_nsv${j}.bed.gz # expression/covariate in BED-like format for that layer & nsv
        for l in {1..300} # chunk index 1..300
        do 
          OUT=${RDR}/${k}/${i}_qtltoolsOutput_${j}_chunk${l}.txt
          echo "QTLtools cis --vcf ${VCF} --bed ${BED} --permute 10000 --chunk ${l} 300 --out ${OUT} --cov ${COV}" >> ${SDR}/selfsched
        #--vcf: genotypes
        #--bed: expression/covariate in BED-like format for that layer & nsv
        #--permute: run permutation testing (empirical p-values)
        #--chunk l 300: split the cis-pairs across 300 chunks and run only chunk l (lets you parallelize)
        #--cov: covariates (e.g., MDS/PCs, etc.)
        #--out: output file for that chunk
        done
      done
    done
  done
  #Count & split the master list
  wc -l ${SDR}/selfsched #18000 selfsched
  split -a4 -d -l50 ${SDR}/selfsched ${SDR}/sch/selfsched_ #split breaks the big file into many small files of 50 lines each in sch/ (so ~360 small lists)

# run selfsched via submiting many small jobs that each run a mini-scheduler
  cd ${SDR}
  for i in `l ${SDR}/sch/selfsched_???? | awk -F"_" '{print $NF}'`
  do
  echo '#!/bin/bash
  #BSUB -q premium
  #BSUB -P acc_psychgen
  #BSUB -J selfsched_'${i}'
  #BSUB -n 11
  #BSUB -W 5:00
  #BSUB -R "rusage[mem=50000]"
  #BSUB -cwd '${SDR}'/log
  #BSUB -oo selfsched_'${i}'.stdout
  #BSUB -eo selfsched_'${i}'.stderr
  #BSUB -L /bin/bash
  module load qtltools/1.1 
  module load tabix
  module load selfsched
  cd '${SDR}'/log 
  export fstatus=selfsched_'${i}'.fstatus
  mpirun -np 11 selfsched < '${SDR}'/sch/selfsched_'${i} > ${SDR}/run/selfsched_${i}.run
  bsub < ${SDR}/run/selfsched_${i}.run
  done

# check jobs finished and rerun fails if needed
  #
  # note: this checking process was complicated and not possible to track here in a neat way 
  #
  cd ${SDR}
  wc -l ${SDR}/selfsched #18000 expected commands
  find ${RDR}/ -wholename "*${RDR}/*qtltoolsOutput*chunk*.txt" | wc -l #16680 | # how many chunk outputs? 16680 here
  find ${SDR}/log/ -wholename "*stdout" | wc -l #360 | # number of job logs (360)
  find ${SDR}/log/ -wholename "*stdout" | xargs -I V grep -m1 -l "Successfully completed" V | wc -l #360 | # count completed jobs (360)
#sanity check: Were all jobs submitted (360 split files × 50 tasks = 18,000 commands)?
#Are all chunk outputs present (here: 16,680 suggests some missing/failed chunks—likely rerun was done outside this snippet)?

# combine chunk outputs: For each nsv and layer, it concatenates the 300 chunk files into one result file,
# ending up with one combined QTLtools output per (callset × nsv × layer)
  cd ${SDR}
  for i in QC2CALLSET ##QC2STRICTCALLSET
  do
    for j in {1..30}
    do 
      for k in MATURERNA PRERNA ##RNA PROTEIN RNAEDITING
      do cat ${RDR}/${k}/${i}_qtltoolsOutput_${j}_chunk*.txt > ${RDR}/${k}/${i}_qtltoolsOutput_${j}.txt
      done
    done
  done

# clean up
  cd ${RDR}
  rm ${RDR}/RNA/QC2{,STRICT}CALLSET*_chunk*.txt & # remove per-chunk files (keeps the combined ones)
  rm ${RDR}/PROTEIN/QC2{,STRICT}CALLSET*_chunk*.txt &
  rm ${RDR}/RNAEDITING/QC2CALLSET*_chunk*.txt &
  rm ${RDR}/RNAEDITING/QC2STRICTCALLSET*_chunk*.txt &
  rm ${RDR}/MATURERNA/QC2CALLSET*_chunk*.txt &
  rm ${RDR}/PRERNA/QC2CALLSET*_chunk*.txt &
  rm -rf ${SDR}/{selfsched,sch,run,log} # remove task lists, splits, run scripts, logs

#+END_SRC

