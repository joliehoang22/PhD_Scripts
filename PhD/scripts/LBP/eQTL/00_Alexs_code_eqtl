# Define function to process each file
process_file <- function(nsv, input_dir, output_dir, dataset) {
  file_path <- paste0(input_dir, dataset, "_nominal_nsv", nsv, ".txt")
  
  dt <- fread(file_path, header = FALSE, sep = " ",
              select = c(1, 8, 12, 13),
              col.names = c("Gene", "variant_id", "p", "b"))
  
  dt[, se := abs(b) / qnorm(p/2, lower.tail = FALSE)]
  dt[p == 0, se := abs(b) / 38]
  
  dt[, c("chr_temp", "bp_temp") := tstrsplit(variant_id, ":", fixed = TRUE)[1:2]]
  dt[, Chr := as.integer(sub("chr", "", chr_temp))]
  dt[, BP := as.integer(sub("\\[.*", "", bp_temp))]
  dt[, SNP := variant_id]
  
  out <- dt[, .(SNP, Chr, BP, Gene, b, se, p)]
  fwrite(out, paste0(output_dir, dataset, "_nsv", nsv, "_osca.txt"), 
         sep = "\t", quote = FALSE)
  
  return(nsv)
}

